PORT=3000
NODE_ENV=development

# PostgreSQL Connection String
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/iq_test_db

# Paystack Secret Key (Use your sk_test_... key for local testing)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# Password used to log into /admin.html
ADMIN_PASSWORD=heislordaura

# Base URL for Paystack payment redirects (Update to your Render URL in production)
BASE_URL=http://localhost:3000
